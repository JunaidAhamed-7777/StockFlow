{
  "name": "StockFlow",
  "install": "bash .cursor/setup.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd server && npm run dev",
      "description": "StockFlow Express API on http://localhost:3001"
    },
    {
      "name": "frontend",
      "command": "cd client && npm run dev",
      "description": "StockFlow Vite dev server on http://localhost:5173"
    }
  ],
  "ports": [
    { "name": "api", "port": 3001 },
    { "name": "web", "port": 5173 }
  ]
}
